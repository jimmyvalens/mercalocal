# Configuración de entorno para Mercalocal
# Copia este archivo a .env y configura los valores reales

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=root
DB_NAME=mercalocal2

# Correo electrónico / SMTP
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=tu-usuario@brevo.com
MAIL_PASS=tu-clave-smtp-de-brevo
MAIL_FROM=noreply@mercalocal.com
MAIL_FROM_NAME=Mercalocal

# Configuración adicional
APP_ENV=development
APP_DEBUG=true
DISPLAY_ERRORS=1
