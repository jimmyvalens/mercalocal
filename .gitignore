# Dependencias administradas por gestores de paquetes (Composer y NPM)
/vendor/
/node_modules/

# Archivos de configuración locales y variables de entorno ocultas
.env
.env.local
.env.*.local

# Bases de datos SQLite o volcados (si los hubiera)
*.sqlite
*.sqlite3
*.db
*.sql

# Logs de errores
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos generados por el Sistema Operativo (Windows/macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Carpetas de configuración de Editores/IDEs (VSCode, PhpStorm, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos temporales o de prueba creados durante el desarrollo
test.html
test.php
output.html
output.txt
header_test.txt
replace_headers.php
create_header.php

# NOTA: Si config.php contiene contraseñas reales de tu base de datos o correos,
# es recomendable descomentar la siguiente línea para que no se suba a GitHub.
/config.php
